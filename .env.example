# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Neon Postgres — from the Vercel Storage / Neon dashboard.
# App runtime uses the pooled URL; migrations use the direct (unpooled) URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js — generate with: npx auth secret   (or `openssl rand -base64 32`)
AUTH_SECRET=
# AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID → Web app)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Single-user lock: only this Google account may sign in.
# Leave blank in local dev to allow the dev-only sign-in.
ALLOWED_EMAIL=
